rules_version = '2';

// Firebase Storage 規則（合併版：Console 既有兩段原樣保留 ＋ 新增 trip-photos）
// 發布方式：整份貼到 Firebase Console → Storage → Rules → 發布
service firebase.storage {
  match /b/{bucket}/o {

    // App 端（Android）：AI 行程插圖 —— 既有段落，原樣保留
    match /itinerary_backgrounds/{file} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
    }

    // 網頁端：行程海報（uploadPosterToStorage）—— 既有段落，原樣保留
    match /posters/{file} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType == 'image/png';
    }

    // 網頁端：旅記景點照片（本次新增）—— 僅本人可寫/刪；
    // 縮圖顯示走含 token 的 downloadURL（不經規則），read 收緊不影響前端
    match /trip-photos/{uid}/{tripId}/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType == 'image/jpeg';
      // delete 必須獨立寫：併進含 request.resource 條件的 write 會讓刪除永遠失敗
      //（delete 沒有 request.resource）
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 網頁端：旅程回顧短片 mp4（uploadRecapToCloud）—— 僅本人可寫/刪；
    // 播放/下載走含 token 的 downloadURL（不經規則），read 收緊成登入即可
    match /recap-videos/{uid}/{tripId}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 200 * 1024 * 1024
                    && request.resource.contentType == 'video/mp4';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
