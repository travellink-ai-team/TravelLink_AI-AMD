{
  "version": 8,
  "name": "TravelLink Offline",
  "glyphs": "asset://offline_map/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles://{PMTILES_URI}",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#DCEBEF" } },
    { "id": "earth", "type": "fill", "source": "basemap", "source-layer": "earth",
      "paint": { "fill-color": "#F4F1EA" } },
    { "id": "landcover", "type": "fill", "source": "basemap", "source-layer": "landcover",
      "paint": { "fill-color": "#E3EDD6", "fill-opacity": 0.7 } },
    { "id": "landuse-green", "type": "fill", "source": "basemap", "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["park", "forest", "wood", "nature_reserve", "national_park", "protected_area", "garden", "grass", "golf_course", "cemetery", "recreation_ground"]]],
      "paint": { "fill-color": "#D5E6C6" } },
    { "id": "landuse-farm", "type": "fill", "source": "basemap", "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["farmland", "orchard", "farmyard", "allotments", "meadow"]]],
      "paint": { "fill-color": "#EDEFD9" } },
    { "id": "landuse-beach", "type": "fill", "source": "basemap", "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["beach", "sand"]]],
      "paint": { "fill-color": "#F5E9C8" } },
    { "id": "water", "type": "fill", "source": "basemap", "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#A9D3DF" } },
    { "id": "water-line", "type": "line", "source": "basemap", "source-layer": "water",
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": { "line-color": "#A9D3DF", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 15, 2] } },
    { "id": "buildings", "type": "fill", "source": "basemap", "source-layer": "buildings", "minzoom": 13,
      "paint": { "fill-color": "#E2DCCF", "fill-opacity": 0.9 } },

    { "id": "roads-path", "type": "line", "source": "basemap", "source-layer": "roads", "minzoom": 13,
      "filter": ["==", ["get", "kind"], "path"],
      "paint": { "line-color": "#B9B2A3", "line-width": 1, "line-dasharray": [2, 1.5] } },
    { "id": "roads-rail", "type": "line", "source": "basemap", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "rail"],
      "paint": { "line-color": "#9A9488", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 15, 2], "line-dasharray": [3, 2] } },
    { "id": "roads-minor-casing", "type": "line", "source": "basemap", "source-layer": "roads", "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["minor_road", "other"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#DDD6C8", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 12, 1.5, 16, 8] } },
    { "id": "roads-minor", "type": "line", "source": "basemap", "source-layer": "roads", "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["minor_road", "other"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 12, 0.8, 16, 6] } },
    { "id": "roads-major-casing", "type": "line", "source": "basemap", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "major_road"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#D7CDB9", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 7, 1, 16, 12] } },
    { "id": "roads-major", "type": "line", "source": "basemap", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "major_road"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFDF7", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 7, 0.6, 16, 9] } },
    { "id": "roads-highway-casing", "type": "line", "source": "basemap", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "highway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#D99B52", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 6, 1.2, 16, 14] } },
    { "id": "roads-highway", "type": "line", "source": "basemap", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "highway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#F6C887", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 6, 0.8, 16, 11] } },
    { "id": "boundaries", "type": "line", "source": "basemap", "source-layer": "boundaries",
      "paint": { "line-color": "#B7A9C9", "line-width": 1, "line-dasharray": [3, 2] } },

    { "id": "roads-label", "type": "symbol", "source": "basemap", "source-layer": "roads", "minzoom": 13,
      "filter": ["in", ["get", "kind"], ["literal", ["highway", "major_road", "minor_road"]]],
      "layout": { "symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#6B6457", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5 } },
    { "id": "water-label", "type": "symbol", "source": "basemap", "source-layer": "water", "minzoom": 11,
      "filter": ["has", "name"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#4F8394", "text-halo-color": "#FFFFFF", "text-halo-width": 1.2 } },
    { "id": "pois", "type": "symbol", "source": "basemap", "source-layer": "pois", "minzoom": 14,
      "filter": ["has", "name"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-max-width": 8 },
      "paint": { "text-color": "#7A7263", "text-halo-color": "#FFFFFF", "text-halo-width": 1.2 } },
    { "id": "places-minor", "type": "symbol", "source": "basemap", "source-layer": "places",
      "filter": ["in", ["get", "kind"], ["literal", ["neighbourhood", "macrohood", "hamlet", "village"]]],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12 },
      "paint": { "text-color": "#5C564B", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5 } },
    { "id": "places-locality", "type": "symbol", "source": "basemap", "source-layer": "places",
      "filter": ["==", ["get", "kind"], "locality"],
      "layout": { "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 16] },
      "paint": { "text-color": "#2F2B25", "text-halo-color": "#FFFFFF", "text-halo-width": 1.8 } }
  ]
}
