<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 以上的備份與換機規則。
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- 使用者自備的 AI 金鑰只屬於這支手機：不進雲端備份，也不在換機時帶走 -->
    <cloud-backup>
        <exclude domain="sharedpref" path="illustration_byok.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="illustration_byok.xml"/>
    </device-transfer>
</data-extraction-rules>
