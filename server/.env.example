# 複製成 server/.env 並填入真實值（server/.env 不進版控）
# Vertex AI API Key（原本放在 app/weather.env.js，改由後端持有，不進瀏覽器）
VERTEX_API_KEY=your-vertex-api-key-here
# TDX client_credentials（走 /api/tdx 代理，不進瀏覽器）
TDX_APP_ID=your-tdx-app-id
TDX_APP_KEY=your-tdx-app-key
# 中央氣象署開放資料授權碼（走 /api/cwa 代理；到 https://opendata.cwa.gov.tw 免費註冊取得）
CWA_API_KEY=your-cwa-api-key
# Firebase Admin 服務帳戶 JSON 路徑（驗證前端 ID token；預設 ../crawler/serviceAccount.json）
# FIREBASE_SERVICE_ACCOUNT_PATH=
# 代理監聽埠（僅本機；對外由 nginx /api/ 反向代理）
PORT=3001
# Google Maps 伺服器端金鑰（Places API (New) 改走 /api/places 代理後需要）
# ★ 必須是「不受 HTTP referrer 限制」的金鑰——瀏覽器用的那把在伺服器端會被 403。
#   建議改用 IP 限制。未設定時 /api/places 會回 503，前端不會靜默拿到空結果。
GOOGLE_MAPS_SERVER_KEY=your-server-side-maps-key
# 文字生成改用 AMD／工研院提供的 gpt-oss-120b（InnoServe AMD 組）。不設或設 vertex 就照舊走 Gemini。
# 圖片生成（gemini-3.1-flash-image）沒有對應模型，一律走 Vertex，所以 VERTEX_API_KEY 仍然必填。
# AI_PROVIDER=amd
# ★ 端點網址只放這裡，不進 repo：只開放登記過的 IP，而且是 http，只能由後端呼叫。
# AMD_LLM_BASE_URL=http://<host>:<port>/v1
# 以下可省略（括號內為預設值）
# AMD_LLM_MODEL=openai/gpt-oss-120b
# AMD_LLM_REASONING_EFFORT=low
# AMD_LLM_REASONING_HEADROOM=1024
